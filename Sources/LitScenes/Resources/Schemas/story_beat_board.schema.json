{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.litscenes/schemas/story_beat_board.v0.2.schema.json",
  "title": "StoryBeatBoard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "beat_board_id",
    "parent_direction_set_id",
    "parent_direction_id",
    "primary_direction_id",
    "source_direction_ids",
    "story_setup_hash",
    "aesthetic_recipe_version",
    "is_active_draft",
    "input_fingerprint",
    "title",
    "logline",
    "central_tension",
    "story_engine",
    "format",
    "target_duration",
    "beginning_state",
    "ending_state",
    "aesthetic_strategy",
    "beats",
    "status",
    "generated_at",
    "updated_at",
    "generator",
    "model",
    "response_id",
    "artifact_status",
    "validation_warnings"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "litscenes.story_beat_board.v0.2" },
    "project_id": { "type": "string" },
    "beat_board_id": { "type": "string" },
    "parent_direction_set_id": { "type": "string" },
    "parent_direction_id": { "type": "string" },
    "primary_direction_id": { "type": "string" },
    "source_direction_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "story_setup_hash": { "type": "string" },
    "aesthetic_recipe_version": { "type": "string" },
    "is_active_draft": { "type": "boolean" },
    "input_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "title": { "type": "string" },
    "logline": { "type": "string" },
    "central_tension": { "type": "string" },
    "story_engine": { "type": "string" },
    "format": { "type": "string" },
    "target_duration": { "type": "string" },
    "beginning_state": { "type": "string" },
    "ending_state": { "type": "string" },
    "aesthetic_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["narrative", "presentation"],
      "properties": {
        "narrative": { "type": "string" },
        "presentation": { "type": "string" }
      }
    },
    "beats": { "type": "array", "minItems": 5, "maxItems": 7, "items": { "$ref": "#/$defs/beat" } },
    "status": { "type": "string" },
    "generated_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "generator": { "type": "string" },
    "model": { "type": "string" },
    "response_id": { "type": "string" },
    "artifact_status": { "type": "string", "enum": ["fresh", "stale", "missing", "legacy"] },
    "validation_warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal_version_id",
        "goal_updated_at",
        "aesthetic_brief_updated_at",
        "chosen_recipe_id",
        "chosen_recipe_version",
        "story_world_hash",
        "source_context_hash",
        "enabled_media_hash",
        "media_observations_hash",
        "story_setup_hash",
        "story_pattern_index_version"
      ],
      "properties": {
        "goal_version_id": { "type": "string" },
        "goal_updated_at": { "type": "string" },
        "aesthetic_brief_updated_at": { "type": "string" },
        "chosen_recipe_id": { "type": "string" },
        "chosen_recipe_version": { "type": "string" },
        "story_world_hash": { "type": "string" },
        "source_context_hash": { "type": "string" },
        "enabled_media_hash": { "type": "string" },
        "media_observations_hash": { "type": "string" },
        "story_setup_hash": { "type": "string" },
        "story_pattern_index_version": { "type": "string" }
      }
    },
    "graph_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "source", "confidence"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "kind": { "type": "string" },
        "source": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "generation_brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "setting",
        "action",
        "visual_focus",
        "camera_or_framing",
        "lighting",
        "aesthetic_treatment",
        "text_overlay",
        "negative_constraints",
        "asset_type_hints"
      ],
      "properties": {
        "subject": { "type": "string" },
        "setting": { "type": "string" },
        "action": { "type": "string" },
        "visual_focus": { "type": "string" },
        "camera_or_framing": { "type": "string" },
        "lighting": { "type": "string" },
        "aesthetic_treatment": { "type": "string" },
        "text_overlay": { "type": "string" },
        "negative_constraints": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "asset_type_hints": { "type": "array", "maxItems": 4, "items": { "type": "string" } }
      }
    },
    "media_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_id",
        "media_id",
        "frame_id",
        "timecode",
        "kind",
        "role",
        "note",
        "thumbnail_path",
        "created_by"
      ],
      "properties": {
        "anchor_id": { "type": "string" },
        "media_id": { "type": "string" },
        "frame_id": { "type": "string" },
        "timecode": { "type": "string" },
        "kind": { "type": "string", "enum": ["image", "video_frame"] },
        "role": { "type": "string", "enum": ["source", "avoid", "reference"] },
        "note": { "type": "string" },
        "thumbnail_path": { "type": "string" },
        "created_by": { "type": "string", "enum": ["user", "suggested"] }
      }
    },
    "beat_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beat_id",
        "order",
        "title",
        "event",
        "visual_moment",
        "emotional_turn",
        "meaning_move",
        "story_function",
        "prompt_ready_line",
        "generation_brief",
        "voice_or_text_overlay",
        "source_media_ids",
        "avoid_media_ids",
        "reference_media_ids",
        "media_anchors"
      ],
      "properties": {
        "beat_id": { "type": "string" },
        "order": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "event": { "type": "string" },
        "visual_moment": { "type": "string" },
        "emotional_turn": { "type": "string" },
        "meaning_move": { "type": "string" },
        "story_function": { "type": "string" },
        "prompt_ready_line": { "type": "string" },
        "generation_brief": { "$ref": "#/$defs/generation_brief" },
        "voice_or_text_overlay": { "type": "string" },
        "source_media_ids": { "type": "array", "items": { "type": "string" } },
        "avoid_media_ids": { "type": "array", "items": { "type": "string" } },
        "reference_media_ids": { "type": "array", "items": { "type": "string" } },
        "media_anchors": { "type": "array", "items": { "$ref": "#/$defs/media_anchor" } }
      }
    },
    "beat_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision_id", "operation", "beat", "created_at"],
      "properties": {
        "revision_id": { "type": "string" },
        "operation": { "type": "string" },
        "beat": { "$ref": "#/$defs/beat_snapshot" },
        "created_at": { "type": "string" }
      }
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beat_id",
        "order",
        "locked",
        "title",
        "event",
        "visual_moment",
        "emotional_turn",
        "meaning_move",
        "story_function",
        "aesthetic_narrative_binding",
        "aesthetic_presentation_binding",
        "prompt_ready_line",
        "generation_brief",
        "voice_or_text_overlay",
        "source_media_ids",
        "avoid_media_ids",
        "reference_media_ids",
        "media_anchors",
        "invented_elements",
        "risks",
        "support_status",
        "origin",
        "meaning_node_refs",
        "beat_function_refs",
        "archetypal_situation_refs",
        "lens_refs",
        "graph_support_summary",
        "validation_warnings",
        "manual_edit_fields",
        "is_deleted",
        "deleted_at",
        "revision_history"
      ],
      "properties": {
        "beat_id": { "type": "string" },
        "order": { "type": "integer", "minimum": 1, "maximum": 7 },
        "locked": { "type": "boolean" },
        "title": { "type": "string" },
        "event": { "type": "string" },
        "visual_moment": { "type": "string" },
        "emotional_turn": { "type": "string" },
        "meaning_move": { "type": "string" },
        "story_function": { "type": "string" },
        "aesthetic_narrative_binding": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "aesthetic_presentation_binding": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "prompt_ready_line": { "type": "string" },
        "generation_brief": { "$ref": "#/$defs/generation_brief" },
        "voice_or_text_overlay": { "type": "string" },
        "source_media_ids": { "type": "array", "maxItems": 24, "items": { "type": "string" } },
        "avoid_media_ids": { "type": "array", "maxItems": 24, "items": { "type": "string" } },
        "reference_media_ids": { "type": "array", "maxItems": 24, "items": { "type": "string" } },
        "media_anchors": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/media_anchor" } },
        "invented_elements": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "risks": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "support_status": {
          "type": "string",
          "enum": ["media_derived", "invented_from_goal_and_aesthetic", "story_pattern_supported", "weak", "unsupported"]
        },
        "origin": {
          "type": "string",
          "enum": ["media_derived", "goal_aesthetic_invention", "user_specified", "story_pattern_index", "from_setup", "from_aesthetic"]
        },
        "meaning_node_refs": { "type": "array", "items": { "$ref": "#/$defs/graph_ref" } },
        "beat_function_refs": { "type": "array", "items": { "$ref": "#/$defs/graph_ref" } },
        "archetypal_situation_refs": { "type": "array", "items": { "$ref": "#/$defs/graph_ref" } },
        "lens_refs": { "type": "array", "items": { "$ref": "#/$defs/graph_ref" } },
        "graph_support_summary": { "type": "string" },
        "validation_warnings": { "type": "array", "items": { "type": "string" } },
        "manual_edit_fields": { "type": "array", "items": { "type": "string" } },
        "is_deleted": { "type": "boolean" },
        "deleted_at": { "type": "string" },
        "revision_history": { "type": "array", "items": { "$ref": "#/$defs/beat_revision" } }
      }
    }
  }
}
