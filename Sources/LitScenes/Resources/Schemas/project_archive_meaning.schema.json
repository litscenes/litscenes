{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.litscenes/schemas/project_archive_meaning.v0.1.schema.json",
  "title": "ProjectArchiveMeaningGraph",
  "type": "object",
  "additionalProperties": false,
