{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.litscenes/schemas/story_single_storyline.v0.1.schema.json",
  "title": "StorySingleStorylineResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "direction",
    "change_summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "litscenes.story_single_storyline_response.v0.1"
    },
    "direction": {
      "$ref": "#/$defs/direction"
    },
    "change_summary": {
      "type": "string"
    }
  },
  "$defs": {
    "aesthetic_use": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrative",
        "presentation"
      ],
      "properties": {
        "narrative": {
          "type": "string"
        },
        "presentation": {
          "type": "string"
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal_fit",
        "aesthetic_narrative_fit",
        "aesthetic_presentation_fit",
        "story_setup_fit",
        "pattern_support",
        "specificity",
        "promptability",
        "novelty",
        "lane_fit",
        "commercial_fit",
        "too_commercial_penalty",
        "generic_slop_penalty",
        "near_duplicate_penalty",
        "final_score"
      ],
      "properties": {
        "goal_fit": {
          "type": "number"
        },
        "aesthetic_narrative_fit": {
          "type": "number"
        },
        "aesthetic_presentation_fit": {
          "type": "number"
        },
        "story_setup_fit": {
          "type": "number"
        },
        "pattern_support": {
          "type": "number"
        },
        "specificity": {
          "type": "number"
        },
        "promptability": {
          "type": "number"
        },
        "novelty": {
          "type": "number"
        },
        "lane_fit": {
          "type": "number"
        },
        "commercial_fit": {
          "type": "number"
        },
        "too_commercial_penalty": {
          "type": "number"
        },
        "generic_slop_penalty": {
          "type": "number"
        },
        "near_duplicate_penalty": {
          "type": "number"
        },
        "final_score": {
          "type": "number"
        }
      }
    },
    "direction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction_id",
        "enabled",
        "lane",
        "title",
        "premise",
        "story_engine",
        "what_happens",
        "why_it_works",
        "aesthetic_use",
        "invented_elements",
        "risk",
        "three_beat_preview",
        "meaning_moves",
        "commercial_pressure",
        "weirdness",
        "promptability",
        "score_debug",
        "validation_warnings"
      ],
      "properties": {
        "direction_id": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "lane": {
          "type": "string",
          "enum": [
            "recommended",
            "bolder",
            "commercial",
            "wildcard"
          ]
        },
        "title": {
          "type": "string"
        },
        "premise": {
          "type": "string"
        },
        "story_engine": {
          "type": "string"
        },
        "what_happens": {
          "type": "string"
        },
        "why_it_works": {
          "type": "string"
        },
        "aesthetic_use": {
          "$ref": "#/$defs/aesthetic_use"
        },
        "invented_elements": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        },
        "risk": {
          "type": "string"
        },
        "three_beat_preview": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string"
          }
        },
        "meaning_moves": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        },
        "commercial_pressure": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "weirdness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "promptability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "score_debug": {
          "$ref": "#/$defs/score"
        },
        "validation_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
